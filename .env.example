# Eternity2 Environment Variables Example
# Copy this file to .env and customize for your deployment

# =============================================================================
# Docker Registry Configuration
# =============================================================================
# Used for building and pushing Docker images
DOCKER_REGISTRY=ghcr.io/startupnationlabs/eternity2
DOCKER_TAG=latest

# =============================================================================
# Frontend Configuration
# =============================================================================

# SERVER_BASE_URL: URL where the Envoy proxy (gRPC-Web gateway) is accessible
# For local development: http://localhost:50052
# For production: https://yourdomain.com/eternity2-api (or your API endpoint)
SERVER_BASE_URL=http://localhost:50052

# BASE_PATH: Path prefix for deployment behind a reverse proxy
# Leave empty for root path deployment
# Example: /eternity2 for deployment at https://yourdomain.com/eternity2
BASE_PATH=

# =============================================================================
# Backend Configuration
# =============================================================================

# SOLVER_API: Hostname of the gRPC server (internal Docker network)
# Usually 'grpc-server' when using docker-compose
SOLVER_API=grpc-server

# =============================================================================
# Production Deployment Notes
# =============================================================================
# When deploying behind a reverse proxy (Traefik, Nginx):
# 1. Set BASE_PATH to your path prefix (e.g., /eternity2)
# 2. Set SERVER_BASE_URL to the public API URL (e.g., https://yourdomain.com/api)
# 3. Configure your reverse proxy to:
#    - Route /eternity2 to the frontend container
#    - Route /eternity2-api (or your chosen path) to the envoy container
#    - Strip the path prefix before forwarding to containers
# 4. Enable HTTPS/TLS at the reverse proxy level
#
# Example production configuration:
# BASE_PATH=/eternity2
# SERVER_BASE_URL=https://terranumerica.fr/eternity2-api
# SOLVER_API=grpc-server
